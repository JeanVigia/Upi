# Copie este arquivo para /etc/upi/upi.env ou para .env na raiz em desenvolvimento.
# Nunca publique o arquivo preenchido no GitHub.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# MySQL
DATABASE_URL=mysql://upi_app:SENHA_DO_BANCO@127.0.0.1:3306/unipinhal

# Gere uma chave nova: openssl rand -base64 48
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_LONGA_E_ALEATORIA

# Login administrativo temporário
LOCAL_ADMIN_USERNAME=Admin
LOCAL_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Google Gemini API (chave somente no backend)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=COLE_A_CHAVE_DO_GOOGLE_AI_STUDIO
LLM_TEXT_MODEL=gemini-3.8-flash
LLM_VISION_MODEL=gemini-3.8-flash

# Diretório persistente de arquivos
STORAGE_DIR=/var/lib/upi/storage
PUBLIC_APP_URL=https://chat.seu-dominio.edu.br
